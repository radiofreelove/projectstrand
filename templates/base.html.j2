<!doctype html>
<html lang="en" data-theme="auto" data-size="m">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'">
<meta name="referrer" content="no-referrer">
<title>{{ page.title }} | {{ site.name }}</title>
<meta name="description" content="{{ page.description }}">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
<link rel="stylesheet" href="{{ asset('css/site.css') }}">
{% if fonts_available %}<link rel="stylesheet" href="{{ asset('css/fonts.css') }}">{% endif %}{% if site_theme == 'spacefast' %}
<link rel="stylesheet" href="{{ asset('css/spacefast-theme.css') }}">{% endif %}
<script src="{{ asset('js/prefs.js') }}"></script>
<script src="{{ asset('js/site.js') }}" defer></script>
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>

<nav class="exit-bar" aria-label="Leave this site quickly">
  <div class="wrap exit-wrap">
    <span class="exit-note">Opens weather.gov. Or press Shift 3 times.</span>
    <a class="exit-link" id="quick-exit" href="{{ site.quick_exit_url }}" rel="noreferrer">Leave quickly<span class="vh"> and open a weather website</span></a>
  </div>
</nav>

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="{{ page_url('index') }}">
      {% include "brand-mark.svg" %}
      <span class="brand-name">{{ site.name }}</span>
    </a>
    <button class="settings-btn js-only" type="button" id="settings-open" aria-haspopup="dialog" aria-controls="settings">Reading settings</button>
  </div>
  <p class="mission wrap"><strong>{{ site.mission }}</strong> {{ site.mission_follow }}</p>
  <nav class="site-nav" aria-label="Main">
    <ul class="wrap">
    {% for p in pages|selectattr('nav', 'defined')|sort(attribute='nav') %}
      <li><a href="{{ page_url(p.slug) }}"{% if p.slug == page.slug %} aria-current="page"{% endif %}>{{ p.nav_label }}</a></li>
    {% endfor %}
    </ul>
  </nav>
</header>

<main id="main" tabindex="-1">
  <div class="beta-bar" role="note" aria-label="Beta notice">
    <p class="wrap"><strong>Independent guide.</strong> Not run by any court or government agency. <strong>Beta.</strong> Checked {{ page.checked|human_date }}. Laws change, so use the official links before you file. <a href="{{ page_url('about#report') }}">Report a mistake</a>.</p>
  </div>
  <div class="wrap content">
    {% if page.get('show_short_toggle', true) %}
    {#- "How much to show" strip. One button turns the "Short version" reading
        setting on and off, in step with the checkbox in Reading settings. Both
        wordings are in the page and CSS picks one from data-brief, which
        prefs.js sets before the page draws, so the strip never flashes the
        wrong state. Needs JavaScript, so it is js-only. It does not print. -#}
    <aside class="brief-strip js-only" aria-label="How much to show">
      <p class="brief-ask"><strong>Still too much to take in?</strong></p>
      <p class="brief-note"><strong>You are seeing the short version.</strong> Some sections are hidden.</p>
      <button type="button" class="btn-secondary brief-toggle" id="brief-toggle" aria-pressed="false"><span class="brief-when-off">Show the short version</span><span class="brief-when-on">Show the full version</span></button>
      <p class="brief-hint">This hides the extra sections on this page. The main steps and the links you need stay here.</p>
    </aside>
    {% endif %}
{% block main %}{% endblock %}

{% if page.slug not in ['sources', '404'] and used_sources() %}
    {% set source_list %}
      <p>Each source shows the date on it and the date we last checked it. <a href="{{ page_url('sources') }}">See every source and what each label means</a>, or read the <a href="{{ repo_url }}/blob/main/docs/claims.md" rel="noreferrer">public fact log</a>.</p>
      <ol>
      {% for s in used_sources() %}
        <li>
          <a href="{{ s.url }}" rel="noreferrer">{{ s.title }}</a>, {{ s.publisher }}.
          Date on it: {{ s.document_date }}.
          Checked: <time datetime="{{ s.checked }}">{{ s.checked|human_date }}</time>.
          {% if s.status == 'unverified' %}<span class="badge badge-unconfirmed">Not confirmed</span>{% elif s.status == 'secondary' %}<span class="badge badge-secondary">Not official</span>{% endif %}
        </li>
      {% endfor %}
      </ol>
    {% endset %}
    <section class="page-sources" aria-labelledby="page-sources-h">
      <h2 id="page-sources-h">Sources for this page</h2>
      {% if page.get('tool') %}
      {#- Tool pages: each result line already links its own source, so the full
          list starts closed (ADR-0010). Every source is still listed. -#}
      <p>Each step above links to its own source.</p>
      <details class="sources-toggle">
        <summary>Show all {{ used_sources()|length }} sources</summary>
        {{ source_list }}
      </details>
      {% else %}
      {{ source_list }}
      {% endif %}
    </section>
{% endif %}
  </div>
  <div class="vh" id="announcer" role="status" aria-live="polite"></div>
</main>

<footer class="site-footer">
  <div class="wrap">
    <p><strong>Independent.</strong> The Strand Project is not run by, or connected to, any court or government agency.</p>
    <p><strong>We explain the process. We are not your lawyer.</strong> For advice about your own situation, <a href="{{ page_url('help') }}">get free or low-cost legal help</a>.</p>
    <p><strong>No cookies. No tracking.</strong> <a href="{{ page_url('privacy') }}">How we protect your privacy</a>.</p>
    <nav aria-label="More pages">
      <ul class="footer-links">
        <li><a href="{{ page_url('why') }}">Why this site exists</a></li>
        <li><a href="{{ page_url('compare') }}">Compare states</a></li>
        <li><a href="{{ page_url('glossary') }}">Words to know</a></li>
        <li><a href="{{ page_url('sources') }}">Every source</a></li>
        <li><a href="{{ page_url('about') }}">About</a></li>
        <li><a href="{{ page_url('accessibility') }}">Accessibility</a></li>
        <li><a href="{{ page_url('privacy') }}">Privacy and safety</a></li>
        <li><a href="{{ repo_url }}" rel="noreferrer">How this site is made (source and audit trail)</a></li>
      </ul>
    </nav>{% if site_theme == 'spacefast' %}
    <p>The colors come from Radix Colors, an open source color system by Radix. Copyright (c) 2021 Radix. Used under the <a href="{{ asset('licenses/radix-mit.txt') }}">MIT License</a>.</p>{% endif %}
    <p class="build-line">Version {{ site.version }}. Built from commit <code>{{ build_commit[:8] }}</code>. <a href="{{ base_path if page.slug == '404' else '' }}build-report.json">Build report</a>. Writing: <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noreferrer">CC BY 4.0<span class="vh"> (outside site)</span></a>. Code: MIT. <a href="{{ page_url('about#license') }}">Reuse this guide</a>.</p>
  </div>
</footer>

<dialog id="settings" aria-labelledby="settings-title">
  <div class="settings-header">
    <h2 id="settings-title">Reading settings</h2>
    <button type="button" class="dialog-close" id="settings-close-x" aria-label="Close reading settings"><span aria-hidden="true">&times;</span></button>
  </div>
  <div class="settings-body settings-inner">
    <p>Change how this site looks. Your choices are saved on this device only. Nothing leaves your device.</p>

    <fieldset>
      <legend>Text size</legend>
      <label><input type="radio" name="size" value="m"> Standard</label>
      <label><input type="radio" name="size" value="l"> Large</label>
      <label><input type="radio" name="size" value="xl"> Extra large</label>
    </fieldset>

    <fieldset>
      <legend>Colors</legend>
      <label><input type="radio" name="theme" value="auto"> Match my device</label>
      <label><input type="radio" name="theme" value="warm"> Warm light</label>
      <label><input type="radio" name="theme" value="light"> Plain white</label>
      <label><input type="radio" name="theme" value="dark"> Dark</label>
      <label><input type="radio" name="theme" value="contrast"> High contrast</label>
    </fieldset>

    <fieldset>
      <legend>Reading</legend>
      <label><input type="checkbox" name="spacing" value="wide"> More space between letters, words, and lines</label>
      {% if fonts_available %}<label><input type="checkbox" name="font" value="hyper"> Use Atkinson Hyperlegible, a font designed so letters are easy to tell apart</label>{% endif %}
      <label><input type="checkbox" name="brief" value="on"> Short version: hide the "Go deeper" sections</label>
    </fieldset>

    <div class="settings-reset">
      <button type="button" class="btn-secondary" id="reset-settings">Reset reading settings</button>
      <p class="hint">Sets text size, colors, spacing, font, and short version back to standard. Keeps your saved checklist.</p>
      <p class="hint" id="reset-status" role="status"></p>
    </div>

    <fieldset class="settings-memory">
      <legend>Privacy and memory</legend>
      <label><input type="checkbox" name="remember" value="on"> Remember my checklist on this device</label>
      <p class="hint">Off unless you turn it on. Your reading settings are saved either way. If someone else uses this device, they could see what is saved.</p>
      <p class="hint"><strong>Warning:</strong> The button below resets reading settings and erases all saved checklist progress on this device.</p>
      <button type="button" class="btn-secondary" id="forget-all">Forget everything saved on this device</button>
      <p class="hint" id="forget-status" role="status"></p>
    </fieldset>
  </div>
  <div class="settings-footer dialog-actions">
    <button type="button" class="btn" id="settings-close">Done</button>
  </div>
</dialog>
</body>
</html>
