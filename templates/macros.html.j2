{#- Reusable building blocks. Every page imports these. -#}

{#- Shared 24x24 inline SVG icons (1.75px rounded strokes, currentColor, zero
    external requests). Decorative icons always set aria-hidden="true" and
    focusable="false". Keep in step with The Stasis Project's icon system. -#}
{% macro icon(name, cls='') -%}
{%- set paths = {
  'alert': '<path d="M12 3L2.5 19.5h19L12 3z"/><path d="M12 9.5v4.5"/><path d="M12 17h.01"/>',
  'info': '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>',
  'check': '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5.5"/>',
  'shield': '<path d="M12 3l7.5 3v6c0 4.5-3.2 7.8-7.5 9-4.3-1.2-7.5-4.5-7.5-9V6L12 3z"/>',
  'dollar': '<path d="M12 3v18"/><path d="M16.5 7.5a3.5 3.5 0 0 0-3.5-2.5h-2a3 3 0 0 0 0 6h2a3 3 0 0 1 0 6h-2.5a3.5 3.5 0 0 1-3.5-2.5"/>',
  'clock': '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  'calendar': '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>',
  'gavel': '<path d="M14 4l6 6-3 3-6-6 3-3z"/><path d="M11 7L4 14l3 3 7-7"/><path d="M3 20h10"/>',
  'id_card': '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11.5" r="2"/><path d="M6.5 16a3 3 0 0 1 5 0"/><path d="M14 10h4.5M14 14h3.5"/>',
  'document': '<path d="M6 3h8l4 4v14H6V3z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 16h6"/>',
  'checklist': '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M8.5 10l1.5 1.5 3-3"/><path d="M14.5 10h2"/><path d="M8.5 15l1.5 1.5 3-3"/><path d="M14.5 15h2"/>',
  'arrow_right': '<path d="M4 12h15"/><path d="M13 6l6 6-6 6"/>',
  'state_or': '<path d="M5 7l2-1.5 4.5 1 6-.5 2.5 1-1 3.5 1 2-1.5 2.5.5 3.5H4.5L4 14l1-7z"/>',
  'state_wa': '<path d="M4 7l3 1 1.5-2 2 1.5V6H20v11.5l-8.5-.5-2.5 1-3-.5-2-3.5 1-3-1-4z"/>',
  'state_ut': '<path d="M6 4h8v4h4v12H6V4z"/>',
  'federal': '<path d="M12 3l7.5 3v6c0 4.5-3.2 7.8-7.5 9-4.3-1.2-7.5-4.5-7.5-9V6L12 3z"/><circle cx="12" cy="11.5" r="3"/><path d="M9 11.5h6"/>'
} -%}
<svg class="icon{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths[name]|safe }}</svg>
{%- endmacro %}

{% macro lede(text) -%}
<p class="lede"><span class="label">The big picture:</span> {{ text }}</p>
{%- endmacro %}

{#- kind: why | do | cost | time | watch | changed | good | note.
    extra=true marks an optional section: "Short version" mode hides it. Never
    mark steps, costs, warnings, or anything a reader needs in order to file.
    Every callout pairs its left border color with a distinct 24x24 shape icon
    and short sentence-case status label so meaning never relies on color alone. -#}
{% macro callout(kind, title, id, extra=false) -%}
{%- set meta = {
  'why': ('info', 'Context'),
  'do': ('checklist', 'Action'),
  'cost': ('dollar', 'Costs'),
  'time': ('clock', 'Timing'),
  'watch': ('alert', 'Watch out'),
  'changed': ('calendar', '2026 update'),
  'good': ('check', 'Good to know'),
  'note': ('shield', 'Note')
}.get(kind, ('info', 'Note')) -%}
<section class="callout callout-{{ kind }}{% if extra %} brief-extra{% endif %}" id="{{ id }}" aria-labelledby="{{ id }}-t">
  <p class="callout-kicker"><span class="callout-icon">{{ icon(meta[0]) }}</span><span>{{ meta[1] }}</span></p>
  <h2 class="callout-title" id="{{ id }}-t">{{ title }}</h2>
  {{ caller() }}
</section>
{%- endmacro %}

{#- A smaller callout that sits inside a section, with a bold title and shape icon. -#}
{% macro box(kind, title) -%}
{%- set icon_name = {
  'why': 'info',
  'do': 'checklist',
  'cost': 'dollar',
  'time': 'clock',
  'watch': 'alert',
  'changed': 'calendar',
  'good': 'check',
  'note': 'shield'
}.get(kind, 'info') -%}
<div class="callout callout-{{ kind }} callout-small">
  <p class="callout-title"><span class="callout-icon">{{ icon(icon_name) }}</span><strong>{{ title }}</strong></p>
  {{ caller() }}
</div>
{%- endmacro %}

{#- "Quick facts" strip for a state page: the key answers and numbers, right
    after the lede and the checked line, before the first callout. Never
    "brief-extra": "Short version" mode keeps it, and it prints.

    Every state page passes the same fields, so the strips line up from state
    to state. Each value must come from data/facts.yml (fact() or fact_src())
    or from a variable the page body also uses, so the strip cannot drift from
    the text below it. Do not type a number or a rule into a call.

    q fields. Required (the build fails if one is missing):
      court_name          court needed for a name change?
      sex_label           row label in the state's own term (see CONTENT-STYLE)
      court_sex           court needed for that change?
      filing_fee          court filing fee
      certified_copy      cost of a certified copy
      birth_certificate   cost to change a birth certificate from this state
      first_step          the title of step 1; links to the page's #steps
    Optional (leave out when the page does not state it):
      license             cost to change a driver license or ID
      whats_new           what the page flags as new or time-sensitive, as
                          {'label', 'text', 'anchor', 'link'}
    The page must have sections with the ids "steps" and "cost". -#}
{% macro quickfacts(page, q) -%}
<section class="callout quick-facts" id="quick-facts" aria-labelledby="quick-facts-t">
  <h2 class="callout-title" id="quick-facts-t"><span class="callout-icon">{{ icon('checklist') }}</span>Quick facts</h2>
  <dl class="quick-facts-list">
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('gavel') }}</span><span>Court needed for a name change</span></dt><dd>{{ q.court_name }}</dd></div>
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('gavel') }}</span><span>{{ q.sex_label }}</span></dt><dd>{{ q.court_sex }}</dd></div>
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('dollar') }}</span><span>Court filing fee</span></dt><dd>{{ q.filing_fee }} <span class="quick-facts-more">Can't pay? <a href="#cost">See what it costs</a>.</span></dd></div>
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('document') }}</span><span>Certified copies</span></dt><dd>{{ q.certified_copy }}</dd></div>
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('document') }}</span><span>{{ page.nav_label }} birth certificate cost</span></dt><dd>{{ q.birth_certificate }}</dd></div>
    {% if q.license is defined %}
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('id_card') }}</span><span>Driver license or ID cost</span></dt><dd>{{ q.license }}</dd></div>
    {% endif %}
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('check') }}</span><span>First step</span></dt><dd><a href="#steps">{{ q.first_step }}</a></dd></div>
    {% if q.whats_new is defined %}
    <div class="quick-facts-row"><dt><span class="qf-icon">{{ icon('shield') }}</span><span>{{ q.whats_new.label }}</span></dt><dd>{{ q.whats_new.text }} <span class="quick-facts-more"><a href="#{{ q.whats_new.anchor }}">{{ q.whats_new.link }}</a></span></dd></div>
    {% endif %}
  </dl>
</section>
{%- endmacro %}

{#- Compact "You are here / Bring this" reminder for long state guides so
    readers do not have to hold paperwork lists in memory across sections. -#}
{% macro bring_reminder(where, items) -%}
<aside class="bring-strip" aria-label="Reminder: {{ where }}">
  <p class="bring-head"><span class="callout-icon">{{ icon('checklist') }}</span><span>You are here: {{ where }}</span></p>
  <p class="bring-label"><strong>Bring or send:</strong> {{ items }}</p>
</aside>
{%- endmacro %}

{#- "What happens after you file" 3-step strip summarizing sourced post-filing
    steps to lower anxiety about what comes next. -#}
{% macro after_filing(id, steps) -%}
<section class="after-strip" id="{{ id }}" aria-labelledby="{{ id }}-t">
  <h3 class="after-title" id="{{ id }}-t"><span class="callout-icon">{{ icon('clock') }}</span>What happens after you file</h3>
  <ol class="after-list">
  {% for item in steps %}
    <li class="after-item">
      <span class="after-head"><span class="after-num">{{ loop.index }}</span><strong>{{ item.title }}</strong></span>
      <span class="after-copy">{{ item.text }}</span>
    </li>
  {% endfor %}
  </ol>
</section>
{%- endmacro %}

{% macro onthispage(items) -%}
<nav class="toc" aria-label="On this page">
  <p class="toc-title">On this page</p>
  <ol>
  {#- An item may carry a third value, 'extra', when the section it points to
      is hidden in "Short version" mode. Its entry then hides with it. -#}
  {% for item in items %}
    <li{% if item|length > 2 and item[2] == 'extra' %} class="brief-extra"{% endif %}><a href="#{{ item[0] }}">{{ item[1] }}</a></li>
  {% endfor %}
  </ol>
</nav>
{%- endmacro %}

{#- A numbered step with a "Done" checkbox. Checkbox state is only saved if
    the reader turns on "Remember" in Reading settings. -#}
{% macro step(slug, n, id, title) -%}
<li class="step" id="{{ id }}">
  <div class="step-head">
    <h3 class="step-title"><span class="step-num">Step {{ n }}</span> {{ title }}</h3>
    <label class="done js-only"><input type="checkbox" data-check="{{ slug }}:{{ id }}"> <span>Done</span><span class="vh"> with step {{ n }}: {{ title }}</span></label>
  </div>
  <div class="step-body">
    {{ caller() }}
  </div>
</li>
{%- endmacro %}

{#- Progressive disclosure. Hidden entirely in "Short version" mode. -#}
{% macro deeper(title, id) -%}
<details class="deeper" id="{{ id }}">
  <summary><span class="deeper-label">Go deeper:</span> {{ title }}</summary>
  <div class="deeper-body">
    {{ caller() }}
  </div>
</details>
{%- endmacro %}

{#- A question-and-answer pair, Vox style. Hidden in "Short version" mode, so
    the heading above a group of these, and its "On this page" entry, carry
    class "brief-extra" and hide with them. -#}
{% macro qa(question, id) -%}
<details class="qa deeper" id="{{ id }}">
  <summary>{{ question }}</summary>
  <div class="deeper-body">
    {{ caller() }}
  </div>
</details>
{%- endmacro %}

{% macro badge(kind) -%}
{%- if kind == 'unconfirmed' -%}<span class="badge badge-unconfirmed">Not confirmed</span>
{%- elif kind == 'inference' -%}<span class="badge badge-inference">Our reading</span>
{%- elif kind == 'changed' -%}<span class="badge badge-changed">Changed in 2026</span>
{%- elif kind == 'official' -%}<span class="badge badge-official">Official</span>
{%- endif -%}
{%- endmacro %}

{#- Text the reader may need to copy: an address, a phone number, an email. -#}
{% macro copyable(text, label) -%}
<span class="copyable"><span class="copy-text">{{ text }}</span> <button type="button" class="copy-btn js-only" data-copy="{{ text }}" aria-label="Copy {{ label }}">Copy</button></span>
{%- endmacro %}

{% macro checked_line(page) -%}
<p class="checked">Last checked against official sources: <time datetime="{{ page.checked }}">{{ page.checked|human_date }}</time>.</p>
{%- endmacro %}
