{#- Reusable building blocks. Every page imports these. -#}

{% macro lede(text) -%}
<p class="lede"><span class="label">The big picture:</span> {{ text }}</p>
{%- endmacro %}

{#- kind: why | do | cost | time | watch | changed | good | note.
    extra=true marks an optional section: "Short version" mode hides it. Never
    mark steps, costs, warnings, or anything a reader needs in order to file. -#}
{% macro callout(kind, title, id, extra=false) -%}
<section class="callout callout-{{ kind }}{% if extra %} brief-extra{% endif %}" id="{{ id }}" aria-labelledby="{{ id }}-t">
  <h2 class="callout-title" id="{{ id }}-t">{{ title }}</h2>
  {{ caller() }}
</section>
{%- endmacro %}

{#- A smaller callout that sits inside a section, with an h3 title. -#}
{% macro box(kind, title) -%}
<div class="callout callout-{{ kind }} callout-small">
  <p class="callout-title"><strong>{{ title }}</strong></p>
  {{ caller() }}
</div>
{%- endmacro %}

{#- "Quick facts" strip for a state page: the key answers and numbers, right
    after the lede and the checked line, before the first callout. Never
    "brief-extra": "Short version" mode keeps it, and it prints.

    Every state page passes the same fields, so the strips line up from state
    to state. Each value must come from data/facts.yml (fact() or fact_src())
    or from a variable the page body also uses, so the strip cannot drift from
    the text below it. Do not type a number or a rule into a call.

    q fields. Required (the build fails if one is missing):
      court_name          court needed for a name change?
      sex_label           row label in the state's own term (see CONTENT-STYLE)
      court_sex           court needed for that change?
      filing_fee          court filing fee
      certified_copy      cost of a certified copy
      birth_certificate   cost to change a birth certificate from this state
      first_step          the title of step 1; links to the page's #steps
    Optional (leave out when the page does not state it):
      license             cost to change a driver license or ID
      whats_new           what the page flags as new or time-sensitive, as
                          {'label', 'text', 'anchor', 'link'}
    The page must have sections with the ids "steps" and "cost". -#}
{% macro quickfacts(page, q) -%}
<section class="callout quick-facts" id="quick-facts" aria-labelledby="quick-facts-t">
  <h2 class="callout-title" id="quick-facts-t">Quick facts</h2>
  <dl class="quick-facts-list">
    <div class="quick-facts-row"><dt>Court needed for a name change</dt><dd>{{ q.court_name }}</dd></div>
    <div class="quick-facts-row"><dt>{{ q.sex_label }}</dt><dd>{{ q.court_sex }}</dd></div>
    <div class="quick-facts-row"><dt>Court filing fee</dt><dd>{{ q.filing_fee }} <span class="quick-facts-more">Can't pay? <a href="#cost">See what it costs</a>.</span></dd></div>
    <div class="quick-facts-row"><dt>Certified copies</dt><dd>{{ q.certified_copy }}</dd></div>
    <div class="quick-facts-row"><dt>{{ page.nav_label }} birth certificate cost</dt><dd>{{ q.birth_certificate }}</dd></div>
    {% if q.license is defined %}
    <div class="quick-facts-row"><dt>Driver license or ID cost</dt><dd>{{ q.license }}</dd></div>
    {% endif %}
    <div class="quick-facts-row"><dt>First step</dt><dd><a href="#steps">{{ q.first_step }}</a></dd></div>
    {% if q.whats_new is defined %}
    <div class="quick-facts-row"><dt>{{ q.whats_new.label }}</dt><dd>{{ q.whats_new.text }} <span class="quick-facts-more"><a href="#{{ q.whats_new.anchor }}">{{ q.whats_new.link }}</a></span></dd></div>
    {% endif %}
  </dl>
</section>
{%- endmacro %}

{% macro onthispage(items) -%}
<nav class="toc" aria-label="On this page">
  <p class="toc-title">On this page</p>
  <ol>
  {#- An item may carry a third value, 'extra', when the section it points to
      is hidden in "Short version" mode. Its entry then hides with it. -#}
  {% for item in items %}
    <li{% if item|length > 2 and item[2] == 'extra' %} class="brief-extra"{% endif %}><a href="#{{ item[0] }}">{{ item[1] }}</a></li>
  {% endfor %}
  </ol>
</nav>
{%- endmacro %}

{#- A numbered step with a "Done" checkbox. Checkbox state is only saved if
    the reader turns on "Remember" in Reading settings. -#}
{% macro step(slug, n, id, title) -%}
<li class="step" id="{{ id }}">
  <div class="step-head">
    <h3 class="step-title"><span class="step-num">Step {{ n }}</span> {{ title }}</h3>
    <label class="done js-only"><input type="checkbox" data-check="{{ slug }}:{{ id }}"> <span>Done</span><span class="vh"> with step {{ n }}: {{ title }}</span></label>
  </div>
  <div class="step-body">
    {{ caller() }}
  </div>
</li>
{%- endmacro %}

{#- Progressive disclosure. Hidden entirely in "Short version" mode. -#}
{% macro deeper(title, id) -%}
<details class="deeper" id="{{ id }}">
  <summary><span class="deeper-label">Go deeper:</span> {{ title }}</summary>
  <div class="deeper-body">
    {{ caller() }}
  </div>
</details>
{%- endmacro %}

{#- A question-and-answer pair, Vox style. Hidden in "Short version" mode, so
    the heading above a group of these, and its "On this page" entry, carry
    class "brief-extra" and hide with them. -#}
{% macro qa(question, id) -%}
<details class="qa deeper" id="{{ id }}">
  <summary>{{ question }}</summary>
  <div class="deeper-body">
    {{ caller() }}
  </div>
</details>
{%- endmacro %}

{% macro badge(kind) -%}
{%- if kind == 'unconfirmed' -%}<span class="badge badge-unconfirmed">Not confirmed</span>
{%- elif kind == 'inference' -%}<span class="badge badge-inference">Our reading</span>
{%- elif kind == 'changed' -%}<span class="badge badge-changed">Changed in 2026</span>
{%- elif kind == 'official' -%}<span class="badge badge-official">Official</span>
{%- endif -%}
{%- endmacro %}

{#- Text the reader may need to copy: an address, a phone number, an email. -#}
{% macro copyable(text, label) -%}
<span class="copyable"><span class="copy-text">{{ text }}</span> <button type="button" class="copy-btn js-only" data-copy="{{ text }}" aria-label="Copy {{ label }}">Copy</button></span>
{%- endmacro %}

{% macro checked_line(page) -%}
<p class="checked">Last checked against official sources: <time datetime="{{ page.checked }}">{{ page.checked|human_date }}</time>.</p>
{%- endmacro %}
